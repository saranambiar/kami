# =============================================================================
# Kami web app — Community Edition (BYOK / self-hosted)
# Copy to web/.env.local — never commit real secrets.
# =============================================================================

# --- REQUIRED ---------------------------------------------------------------
# Local Hermes gateway (default). Do not point at a third-party hosted key.
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=change-me-to-match-your-API_SERVER_KEY

# Your own Supabase project (free tier is fine)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- RESEARCH (pick at least one path) --------------------------------------
# Default free path: connect a dedicated Chrome debug profile to Hermes (CDP).
# Optional faster research providers (BYOK — not required):
# LINKUP_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=

# Browser research (optional — set after you consent to a dedicated profile)
# HERMES_BROWSER_CDP_URL=http://127.0.0.1:9222

# --- SALES SEND (optional — drafts work without this) -----------------------
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX=you@agentmail.to

# --- X / SOCIAL (optional — opportunity drafts work without publish) --------
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# APIFY_API_TOKEN=

# --- OPTIONAL OBSERVABILITY -------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
