# Kami web — environment template. Copy to .env.local / Vercel. Never commit real keys.

# Production Hermes (EC2 behind Caddy)
HERMES_GATEWAY_URL=https://api.trykami.app/v1/chat/completions
HERMES_API_KEY=

# Local laptop testing (optional override)
# HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions

# Supabase (persistence — app runs without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Linkup live web research (Vercel-side pre-research + Hermes)
LINKUP_API_KEY=

# AgentMail email surface
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=

# X OAuth 2.0 app credentials — Kami app identity. Users log in with X from the UI.
# From developer.x.com → your app → OAuth 2.0 Keys.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Production callback (also register in the X app):
X_REDIRECT_URI=https://www.trykami.app/api/auth/x/callback
# Local:
# X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# Marketing — Instagram OAuth (Instagram API with Instagram Login)
# Meta App Dashboard → Instagram → API setup with Instagram login → Business login settings
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Production callback (also register in Meta Valid OAuth Redirect URIs):
INSTAGRAM_REDIRECT_URI=https://www.trykami.app/api/auth/instagram/callback
# Local:
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Optional legacy Graph token (server-only hashtag seed; prefer user OAuth + Apify for creators)
INSTAGRAM_ACCESS_TOKEN=

# Creator discovery — Apify (required to find Instagram creators by niche)
# https://console.apify.com/account/integrations → API token
APIFY_API_TOKEN=
# Optional actor id override (default: apify/instagram-hashtag-scraper)
# APIFY_IG_HASHTAG_ACTOR=apify/instagram-hashtag-scraper

# Marketing — X Ads API (optional; without these, Boost queues as pending)
X_ADS_ACCESS_TOKEN=
X_ADS_ACCOUNT_ID=

# Marketing — Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
