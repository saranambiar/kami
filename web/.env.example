# Kami web — environment template. Copy to .env.local and fill in. Never commit real keys.

# Hermes gateway (required)
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=

# Supabase (persistence — app runs without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Linkup live web research (optional)
LINKUP_API_KEY=

# AgentMail email surface (optional)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=

# X OAuth 2.0 app credentials — identifies the Kami app. Users log in with X
# from the UI; their tokens are stored per-account in connected_accounts.
# From developer.x.com → your app → OAuth 2.0 Keys.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Callback registered in the X app's User authentication settings:
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback
