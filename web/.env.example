# Kami web — environment template. Copy to .env.local and fill in. Never commit real keys.

# Hermes gateway (required)
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=

# Supabase (persistence — app runs without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Linkup live web research (optional)
LINKUP_API_KEY=

# AgentMail email surface (optional)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=

# X — DEV FALLBACK ONLY. In production users connect their own keys via the UI
# (Connect X → verified live → stored in connected_accounts).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
