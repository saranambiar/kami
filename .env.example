# =============================================================================
# Hermes environment template (not for the Next.js app).
# Copy to Hermes home:
#   Windows: %LOCALAPPDATA%\hermes\.env
#   macOS / Linux: ~/.hermes/.env
# Web app vars: copy web/.env.example → web/.env.local (see SETUP.md).
# Never commit real secrets.
# =============================================================================

# --- LLM provider (pick ONE path) -------------------------------------------
# Path chosen for this project: OpenAI direct BYOK (no Nous Portal credits).
OPENAI_API_KEY=
# Optional alternatives:
# Path A: Nous Portal OAuth — hermes setup --portal
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Hermes API Server (required for web frontend → Hermes) -----------------
# Enables OpenAI-compatible /v1/chat/completions on the gateway process.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=change-me-to-a-long-random-secret
# Browser-direct CORS (only if frontend calls Hermes from the browser):
# API_SERVER_CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# --- Web / research tools ---------------------------------------------------
# Default free path: dedicated Chrome CDP (see scripts/browser-connect.md)
# HERMES_BROWSER_CDP_URL=http://127.0.0.1:9222
# Optional BYOK research providers (not required):
# LINKUP_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# PARALLEL_API_KEY=

# --- Real email surface (pick ONE; lock in hour 1) ---------------------------
# Option A: AgentMail MCP (agent-native inbox)
# AGENTMAIL_API_KEY=
# Option B: Gmail SMTP/API (real inbox; not sandbox)
# GMAIL_APP_PASSWORD=
# EMAIL_ADDRESS=
# Option C: Resend
# RESEND_API_KEY=

# --- Real content surface (X / Twitter) -------------------------------------
# X pay-per-use (plain-text posts preferred for cost)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# Or XAI_API_KEY= for Hermes x_search / related tools

# --- Optional messaging gateway (nice-to-have, not primary judge surface) ---
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# --- Optional power-ups / integrations --------------------------------------
# GITHUB_TOKEN=          # better Skills Hub rate limits
# ELEVENLABS_API_KEY=    # voice briefing power-up
# CONVEX / Linkup / Cloudflare usually configured in their own dashboards
